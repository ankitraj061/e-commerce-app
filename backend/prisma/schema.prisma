generator client {
  provider = "prisma-client-js"
}

datasource db {
  // In Prisma 7, `url` is removed from the schema.
  // Connection URL lives in prisma.config.ts (for migrations)
  // and is passed to PrismaClient via `datasourceUrl` (for the client).
  provider = "postgresql"
}

//
// ENUMS
//

enum ReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PLACED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

//
// USER
//

model User {
  id                  String         @id @default(cuid())
  name                String
  email               String         @unique
  password            String
  selectedWarehouseId String?
  selectedWarehouse   Warehouse?     @relation("SelectedWarehouse", fields: [selectedWarehouseId], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  addresses           Address[]
  reservations        Reservation[]
  orders              Order[]
  refreshTokens       RefreshToken[]
}

//
// ADDRESS
//

model Address {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  street       String
  city         String
  state        String
  pincode      String
  country      String
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  reservations Reservation[]
  orders       Order[]
}

//
// WAREHOUSE
//

model Warehouse {
  id             String      @id @default(cuid())
  name           String
  city           String
  state          String
  pincode        String
  country        String
  image          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  inventories    Inventory[]
  reservations   Reservation[]
  selectedByUsers User[]     @relation("SelectedWarehouse")
}

//
// PRODUCT
//

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  image       String
  price       Decimal     @db.Decimal(10, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventories Inventory[]
  reservations Reservation[]
  orderItems  OrderItem[]
}

//
// INVENTORY
//

model Inventory {
  id            String    @id @default(cuid())
  productId     String
  warehouseId   String
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  totalStock    Int
  reservedStock Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([productId, warehouseId])
  @@index([warehouseId])
  @@index([productId])
}

//
// RESERVATION
//

model Reservation {
  id                String            @id @default(cuid())
  userId            String
  productId         String
  warehouseId       String
  deliveryAddressId String
  quantity          Int
  status            ReservationStatus @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  expiresAt         DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  product           Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse         Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  deliveryAddress   Address           @relation(fields: [deliveryAddressId], references: [id], onDelete: Cascade)
  payment           Payment?
  order             Order?

  @@index([status])
  @@index([expiresAt])
  @@index([userId])
  @@index([warehouseId])
}

//
// PAYMENT
//

model Payment {
  id                String        @id @default(cuid())
  reservationId     String        @unique
  razorpayOrderId   String        @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  reservation       Reservation   @relation(fields: [reservationId], references: [id], onDelete: Cascade)
}

//
// ORDER
//

model Order {
  id            String      @id @default(cuid())
  userId        String
  reservationId String      @unique
  addressId     String
  totalAmount   Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PLACED)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  address       Address     @relation(fields: [addressId], references: [id], onDelete: Cascade)
  items         OrderItem[]

  @@index([userId])
  @@index([status])
}

//
// ORDER ITEM
//

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

//
// REFRESH TOKEN
//

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
